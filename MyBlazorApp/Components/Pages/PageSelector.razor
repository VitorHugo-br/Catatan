<nav aria-label="Page navigation example">
    <ul class="pagination">

        <li class="page-item @(_currentPage == 0 ? "disabled" : "") pointer">
            <a class="page-link" @onclick="PreviousPage">Previous</a>
        </li>

        @if (_windowStart > 0)
        {
            <li class="page-item disabled">
                <span class="page-link">...</span>
            </li>
        }

        @for (var i = _windowStart; i < WindowEnd; i++)
        {
            var pageIndex = i + 1;
            <li class="page-item @(_currentPage == pageIndex ? "active" : "") pointer">
                <a class="page-link" @onclick="() => GoToPage(pageIndex)">@(pageIndex)</a>
            </li>
        }

        @if (WindowEnd < TotalPages)
        {
            <li class="page-item disabled">
                <span class="page-link">...</span>
            </li>
        }

        <li class="page-item @(_currentPage == TotalPages - 1 ? "disabled" : "") pointer" >
            <a class="page-link" @onclick="NextPage">Next</a>
        </li>

    </ul>
</nav>