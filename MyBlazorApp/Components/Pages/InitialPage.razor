@page "/"
@using MyBlazorApp.Components.Forms
@rendermode InteractiveServer
@layout AuthLayout

<PageTitle>TaskMan - @(EhLogin ? "Login" : "Cadastro")</PageTitle>

<main class="card-central">
    <div class="painel-esquerda">
        <div class="icone-titulo">
            <MudIcon Icon="@Icons.Material.Filled.StickyNote2" Title="TaskMan" Color="Color.Primary" Size="Size.Large" />
            <h2>TaskMan</h2>
        </div>
        <div class="bem-vindo">
            <div class="subtitulo-boas-vindas">@(EhLogin ? "Acesse sua conta" : "Crie sua conta")</div>
            <h1>
                @(EhLogin ? "Bem-Vindo" : "Junte-se")
                <span>@(EhLogin ? "de volta." : "a nós.")</span>
            </h1>
            <p>
                @(EhLogin ? "Acesse sua conta para continuar." : "Crie sua conta para gerenciar suas tarefas.")
                <br />Dados protegidos com criptografia de ponta a ponta.
            </p>
        </div>
        <div class="versao">
            V1.0.0 - @DateTime.Today.Year
        </div>
    </div>
    <div class="painel-direita">
        <div class="titulo">
            <div></div>
            <span>@Titulo</span>
            <div></div>
        </div>
        @if (EhLogin)
        {
            <LoginForm OnRegisterClicked="AlternarLoginCadastro" />
        }
        else
        {
            <RegisterForm OnLoginClicked="AlternarLoginCadastro" />
        }
    </div>
</main>