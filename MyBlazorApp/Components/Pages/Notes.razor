@page "/chamados/"
@using MyBlazorApp.Models.DTO

<PageTitle>TaskMan - Chamados</PageTitle>

<div class="chamados-container">
    <MudPaper Elevation="1" Class="chamados-paper">
        <MudDataGrid Items="@Data"
                     Dense="true"
                     Hover="true"
                     Filterable="true"
                     FixedHeader="true"
                     Height="calc(100vh - 130px)"
                     Class="chamados-datagrid">
            <Columns>
                <PropertyColumn Title="ID" Property="x => x.Id" HeaderClass="col-id" CellClass="col-id">
                    <CellTemplate>
                        #@context.Item.Id.ToString("D4")
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Title="Título" Property="x => x.Titulo" HeaderClass="col-titulo" CellClass="col-titulo" />
                <PropertyColumn Title="Status" Property="x => x.Status" CellStyleFunc="@_cellStyleFunc" HeaderClass="col-status" CellClass="col-status" />
                <PropertyColumn Title="Criador" Property="x => x.Remetente!.Nome" HeaderClass="col-criador" CellClass="col-criador" />
                <PropertyColumn Title="Responsável" Property='x => x.Responsavel != null ? x.Responsavel.Nome : "Não Atribuído"' HeaderClass="col-responsavel" CellClass="col-responsavel">
                    <CellTemplate>
                        @if (context.Item.Responsavel is null)
                        {
                            @("Não Atribuído")
                        }
                        else
                        {
                            @context.Item.Responsavel.Nome
                        }
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Title="Data de Início" Property="x => x.DataInicio" HeaderClass="col-data" CellClass="col-data">
                    <CellTemplate>
                        @if (context.Item.DataInicio is null)
                        {
                            @("Não Atribuído")
                        }
                        else
                        {
                            @(context.Item.DataInicio?.ToString("d"))
                        }
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Title="Prazo" Property="x => x.Prazo" HeaderClass="col-data" CellClass="col-data">
                    <CellTemplate>
                        @if (context.Item.Prazo is null)
                        {
                            @("Não Atribuído")
                        }
                        else
                        {
                            @(context.Item.Prazo?.ToString("d"))
                        }
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Title="Data de Efetiva Entrega" Property="x => x.DataTermino" HeaderClass="col-data" CellClass="col-data">
                    <CellTemplate>
                        @if (context.Item.DataTermino is null)
                        {
                            @("Não Atribuído")
                        }
                        else
                        {
                            @(context.Item.DataTermino?.ToString("d"))
                        }
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Title="Data de Criação" Property="x => x.CriadoEm" HeaderClass="col-data" CellClass="col-data">
                    <CellTemplate>
                        @(context.Item.CriadoEm.ToString("d"))
                    </CellTemplate>
                </PropertyColumn>
            </Columns>
            <PagerContent>
                <MudDataGridPager T="ChamadoApiResponse" PageSizeOptions="new[] { 10, 20, 50 }" />
            </PagerContent>
        </MudDataGrid>
    </MudPaper>
</div>