@page "/chamados/"

<PageTitle>Catatan - Notes</PageTitle>

<MudDataGrid Items="@Data" Dense="true" Filterable="true">
    <Columns>
        <PropertyColumn Title="ID" Property="x => x.Id"/>
        <PropertyColumn Title="Titulo" Property="x => x.Title" />
        <PropertyColumn Title="Status" Property="x => x.Status" CellStyleFunc="@_cellStyleFunc" />
        <PropertyColumn Title="Criador" Property="x => x.Issuer!.Nome" />
        <PropertyColumn Title="Responsável" Property='x => x.User != null ? x.User.Nome : "Não Atribuido"'>
            <CellTemplate>
                @if(context.Item.User is null)
                {
                    @("Não Atribuido")
                }
                else
                {
                    @context.Item.User.Nome
                }
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Title="Data de inicio" Property="x => x.StartDate">
            <CellTemplate>
                @if (context.Item.StartDate is null)
                {
                    @("Não Atribuido")
                }
                else
                {
                    @context.Item.StartDate
                }
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Title="Prazo" Property="x => x.DueDate">
            <CellTemplate>
                @if (context.Item.DueDate is null)
                {
                    @("Não Atribuido")
                }
                else
                {
                    @context.Item.DueDate
                }
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Title="Data de efetiva entrega" Property="x => x.EndDate">
            <CellTemplate>
                @if (context.Item.EndDate is null)
                {
                    @("Não Atribuido")
                }
                else
                {
                    @context.Item.EndDate
                }
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Title="Data de Criação" Property="x => x.CreatedAt" />
    </Columns>
    <PagerContent>
        <MudDataGridPager @T="NotesPageResponse" />
    </PagerContent>
</MudDataGrid>