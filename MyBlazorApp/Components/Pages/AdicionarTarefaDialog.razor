<MudDialog >
    <TitleContent><strong>Criar nova tarefa</strong></TitleContent>
    <DialogContent>
        <MudForm 
            @ref="_form" 
            @bind-IsValid="@_success" 
            @bind-Errors="@_errors" 
            OnEnterPressed="@(() => _form.ValidateAsync())"
            Spacing="3"
            >
            <MudTextField 
                T="string" 
                @bind-Value="_formModel.Title" 
                Label="Titulo" 
                Required="true" 
                RequiredError="Titulo é obrigatório!" 
                />
            <MudTextField 
                T="string" 
                @bind-Value="_formModel.Description" 
                Label="Descrição" 
                Required="true"
                Lines="3"
                MaxLines="6"
                RequiredError="Descrição é obrigatório!" 
                />
            <MudTextField 
                T="DateTime?" 
                @bind-Value="_formModel.DueDate" 
                Format="s" 
                Label="Prazo" 
                InputType="InputType.DateTimeLocal"
                />
            <MudSelect @bind-Value="_formModel.Status" Label="Status">
                <MudSelectItem Value="0">Pendente</MudSelectItem>
                <MudSelectItem Value="1">Em progresso</MudSelectItem>
                <MudSelectItem Value="2">Concluído</MudSelectItem>
                <MudSelectItem Value="3">Entregue</MudSelectItem>
            </MudSelect>
            <MudSelect @bind-Value="_formModel.UserId" Label="atribuido para">
                @foreach(var usuario in Users)
                {
                    <MudSelectItem Value="usuario.Id">@usuario.Name</MudSelectItem>
                }
            </MudSelect>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton
            Color="Color.Success"
            @onclick="Submit"
            StartIcon="@Icons.Material.Filled.Add">
            <div style="position: relative; top: 2px;">
                Adicionar
            </div>
        </MudButton>
    </DialogActions>
</MudDialog>