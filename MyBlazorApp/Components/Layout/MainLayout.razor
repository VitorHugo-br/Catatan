@inherits LayoutComponentBase

<MudThemeProvider IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudDrawerContainer Class="mud-height-full">
    <MudDrawer @bind-Open="@_open"
               Fixed="false"
               Elevation="1"
               Variant="@DrawerVariant.Mini"
               OpenMiniOnHover
               Breakpoint="Breakpoint.None">
        <MudNavMenu>
            <MudNavLink Match="NavLinkMatch.All" IconColor="Color.Primary" Icon="@Icons.Material.Filled.StickyNote2">

            </MudNavLink>
            <MudDivider />
            <MudNavLink Match="NavLinkMatch.All" IconColor="Color.Primary" Icon="@Icons.Material.Filled.Home" OnClick="@(() => NavegarPara("Home"))">Home</MudNavLink>
            <MudDivider />
            <MudNavLink Match="NavLinkMatch.All" IconColor="Color.Primary" Icon="@Icons.Material.Filled.LibraryBooks" OnClick="@(() => NavegarPara("Chamados"))">Chamados</MudNavLink>
            <MudDivider />
        </MudNavMenu>
    </MudDrawer>

    <div class="mud-height-full">
        <MudToolBar>
            <MudTextField T="string"
                          @bind-Value="@NumeroChamado"
                          Label="Numero do chamado"
                          Clearable
                          Sizing="InputSizing.Fixed"
                          Style="@("width: 25%;")"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          AdornmentColor="Color.Inherit"
                          OnAdornmentClick="BuscarChamado" />
            <MudSpacer />
            @* <MudSwitch @bind-Value="@_modoEscuro"
                       @bind-Value:after="SaveTheme"
                       ThumbIcon="@ModoEscuroIcone"
                       ThumbIconColor="@(_modoEscuro == true ? Color.Warning : Color.Dark)"/> *@
            <MudTooltip Text="Adicionar" Placement="Placement.Left">
                <MudFabMenu StartIcon="@Icons.Material.Outlined.Add" Color="Color.Primary" Direction="Direction.Bottom" Size="Size.Small" IconSize="Size.Small">
                    <MudTooltip Text="Chamado" Placement="Placement.Left"><MudFabMenuItem StartIcon="@Icons.Material.Outlined.StickyNote2" Color="Color.Primary" OnClick="AdicionarTarefa" /></MudTooltip>
                    <MudTooltip Text="Grupo" Placement="Placement.Left"><MudFabMenuItem StartIcon="@Icons.Material.Outlined.PeopleAlt" Color="Color.Primary" /></MudTooltip>
                </MudFabMenu>
            </MudTooltip>
            <MudIconButton Icon="@Icons.Material.Outlined.ExitToApp" Color="Color.Error" OnClick="Sair" />
        </MudToolBar>
        <MudDivider />

        @Body
    </div>

</MudDrawerContainer>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
