@inherits LayoutComponentBase


<MudDrawerContainer Class="mud-height-full">
    <MudDrawer @bind-Open="@_open"
               Fixed="false"
               Elevation="1"
               Variant="@DrawerVariant.Mini"
               OpenMiniOnHover
               Breakpoint="Breakpoint.None">
        <MudNavMenu>
            <MudNavLink Match="NavLinkMatch.All" IconColor="Color.Primary" Icon="@Icons.Material.Filled.StickyNote2">
                
            </MudNavLink>
            <MudDivider />
            <MudNavLink Match="NavLinkMatch.All" IconColor="Color.Primary" Icon="@Icons.Material.Filled.Home" OnClick="@(() => NavegarPara("Home"))">Home</MudNavLink>
            <MudDivider />
            <MudNavLink Match="NavLinkMatch.All" IconColor="Color.Primary" Icon="@Icons.Material.Filled.LibraryBooks" OnClick="@(() => NavegarPara("Notes"))">Chamados</MudNavLink>
            <MudDivider />
        </MudNavMenu>
    </MudDrawer>

    <div class="mud-height-full">
        <MudToolBar>
            <MudTextField T="string"
                          @bind-Value="@NumeroChamado"
                          Label="Numero do chamado"
                          Clearable
                          Sizing="InputSizing.Fixed"
                          Style="@("width: 25%;")"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          AdornmentColor="Color.Inherit"
                          OnAdornmentClick="BuscarChamado" />
            <MudSpacer />
            <MudSwitch @bind-Value="@_modoEscuro"
                       @bind-Value:after="SaveTheme"
                       ThumbIcon="@ModoEscuroIcone"
                       ThumbIconColor="@(_modoEscuro == true ? Color.Warning : Color.Dark)"/>
            <MudIconButton Icon="@Icons.Material.Outlined.Add" OnClick="AdicionarTarefa" />
            <MudIconButton Icon="@Icons.Material.Outlined.PeopleAlt" />
            <MudIconButton Icon="@Icons.Material.Outlined.ExitToApp" Color="Color.Error" OnClick="Sair" />
        </MudToolBar>
        <MudDivider />
        <MudThemeProvider IsDarkMode="@_modoEscuro" />
        <MudPopoverProvider />
        <MudDialogProvider />
        <MudSnackbarProvider />
        @Body
    </div>

</MudDrawerContainer>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
